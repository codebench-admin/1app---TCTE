PORT=4000
DATABASE_URL=postgresql://runway_user:runway_pass@localhost:5432/runway
JWT_SECRET=change_this_to_a_long_random_string
CORS_ORIGIN=http://localhost:5173

# Where uploaded documents (contracts, riders, receipts) are stored on disk
# in dev. Swap backend/src/utils/storage.js for S3/R2 calls in production —
# a shared-hosting/Node box has no durable disk across deploys.
UPLOAD_DIR=./uploads
